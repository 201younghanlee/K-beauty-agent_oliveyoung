OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PUBLIC_LLM_ENABLED=true
PRODUCT_REASON_LLM_ENABLED=true
ADMIN_TOKEN=replace-with-a-long-random-token
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///data/k_beauty_agent.sqlite3
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://k-beauty-agent.apps.tossmini.com,https://k-beauty-agent.private-apps.tossmini.com
COOKIE_SAMESITE=lax
SECURE_COOKIES=false
RECOMMEND_RATE_LIMIT_REQUESTS=30
RECOMMEND_RATE_LIMIT_WINDOW_SECONDS=60

# catalog_snapshot combines the verified catalog with the checked-in generated snapshot.
# live_keyless is retained for local experiments and should not power public traffic.
PRODUCT_SOURCE=catalog_snapshot
EXTERNAL_CACHE_URL=sqlite:///data/external_product_cache.sqlite3
KRW_PER_USD=1350
OLIVEYOUNG_SNAPSHOT_CSV=data/oliveyoung_snapshot.csv
OLIVEYOUNG_SNAPSHOT_HTML_DIR=data/oliveyoung_snapshots
OPEN_BEAUTY_FACTS_API_URL=https://world.openbeautyfacts.org/cgi/search.pl
COSING_API_URL=https://ec.europa.eu/growth/tools-databases/cosing/api/ingredients

# Commerce v2 and approved affiliate sources. Leave credentials empty until the
# corresponding partner account and Apps in Toss review are approved.
AFFILIATE_REDIRECT_SECRET=replace-with-a-separate-long-random-secret
AFFILIATE_WEBHOOK_SECRET=
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_API_BASE=https://api-gateway.coupang.com
COUPANG_PARTNERS_SEARCH_PATH=/v2/providers/affiliate_open_api/apis/openapi/v1/products/search

# Optional normalized feeds supplied by an approved affiliate network. Both the
# feed host and every retailer destination host must be explicitly allowlisted.
# Secrets are referenced by environment-variable name, never embedded in JSON.
PARTNER_FEEDS_JSON=[]

# Comma-separated source IDs whose affiliate contracts and Toss disclosures
# have been approved. Keep empty until approval; configured feeds then stay inactive.
ACTIVE_AFFILIATE_SOURCE_IDS=
